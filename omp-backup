#!/usr/bin/env bash
# Usage: omp-backup
if pgrep -x omp >/dev/null; then
	printf '%s\n' 'Stop OMP before backing up.' >&2
	exit 1
fi

backup_dir="/media/airtonp/internal-hdd/Backups/omp"
mkdir -p "$backup_dir"
umask 077

archive="$backup_dir/omp-$(date +%Y%m%d-%H%M%S).tar.gz"
tar_args=(
	# Create a new archive.
	--create
	# Compress the archive with gzip.
	--gzip
	# Write the archive to this file.
	--file="$archive"
	# Store .omp relative to the home directory.
	--directory="$HOME"
	# Follow symlinks and store copies of their target files.
	--dereference
	# Exclude generated caches.
  --exclude='cache'
)

tar "${tar_args[@]}" .omp
printf '%s\n' "$archive"
